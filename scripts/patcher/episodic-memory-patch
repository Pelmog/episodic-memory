# Codex launcher's can never pick different directories.
REQUIRED = ("dist/summarizer.js", "cli/mcp-server-wrapper.js")

# id, why, ORIGINAL (unpatched) regex, PATCHED regex, replacement.
# \1/\2 carry the file's own indentation, so one definition fits both the
# 8-space dist/summarizer.js and the 4-space src/summarizer.ts.
PATCHES = [
