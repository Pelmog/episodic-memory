#!/usr/bin/env python3
"""Re-apply the local episodic-memory summarizer patches after a plugin upgrade.

Idempotent and loud: it refuses to guess. Any state that is not cleanly
"patched" or cleanly "unpatched" is reported as needing a human, never silently
half-fixed. See the codex-episodic-memory-access / episodic-memory-patch-tool
memories for why these patches exist.
"""
import argparse, contextlib, copy, fcntl, hashlib, io, json, os, re, shlex, signal, subprocess, sys, tempfile
from pathlib import Path

DEFAULT_ROOT = Path.home() / ".claude/plugins/cache/superpowers-marketplace/episodic-memory"
ROOT = Path(os.environ.get("EPISODIC_MEMORY_PLUGIN_ROOT", DEFAULT_ROOT))

