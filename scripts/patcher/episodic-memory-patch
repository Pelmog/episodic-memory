        "summarizer's Claude calls must not inherit MCP servers or user settings",
        re.compile(r"^([ \t]*)max_tokens: 4096,\n([ \t]*)env: getApiEnv\(\),", re.M),
        re.compile(r"^[ \t]*max_tokens: 4096,\n[ \t]*mcpServers: \{\},\n"
                   r"[ \t]*strictMcpConfig: true,\n[ \t]*settingSources: \[\],\n"
                   r"[ \t]*env: getApiEnv\(\),", re.M),
        r"\1max_tokens: 4096,\n\1mcpServers: {},\n\1strictMcpConfig: true,\n"
        r"\1settingSources: [],\n\2env: getApiEnv(),",
    ),
    (
