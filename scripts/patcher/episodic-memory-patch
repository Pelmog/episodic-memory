        "codex-cli >=0.150 rejects paginated thread/fork without it (upstream #158)",
        re.compile(r"^([ \t]*)threadId: command\.sessionId,\n"
                   r"([ \t]*)ephemeral: true,\n(?![ \t]*excludeTurns:)", re.M),
        re.compile(r"^[ \t]*threadId: command\.sessionId,\n[ \t]*ephemeral: true,\n"
                   r"[ \t]*excludeTurns: true,\n", re.M),
        r"\1threadId: command.sessionId,\n\2ephemeral: true,\n\2excludeTurns: true,\n",
    ),
